{
  "id": "./",
  "name": "VOID-20 Equalizer",
  "short_name": "VOID-20",
  "description": "20-band equalizer, custom bands, ultra deep bass, speaker guard and APEX party mode. Shapes your own files and audio playing in other music apps.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#05070f",
  "theme_color": "#05070f",
  "lang": "en",
  "dir": "ltr",
  "categories": ["music", "entertainment", "utilities"],
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/mp4": [".m4a"],
        "audio/aac": [".aac"],
        "audio/wav": [".wav"],
        "audio/ogg": [".ogg", ".oga", ".opus"],
        "audio/flac": [".flac"],
        "audio/webm": [".weba"],
        "audio/aiff": [".aif", ".aiff"]
      }
    }
  ]
}
